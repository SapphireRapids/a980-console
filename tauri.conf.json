{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A980 控制台",
  "version": "1.0.0",
  "identifier": "com.sapphirerapids.a980-console",
  "build": {
    "frontendDist": "frontend",
    "devUrl": "http://127.0.0.1:4399"
  },
  "app": {
    "windows": [
      {
        "title": "A980 控制台",
        "width": 794,
        "height": 678,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
